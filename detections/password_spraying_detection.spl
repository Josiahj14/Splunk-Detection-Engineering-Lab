index=security_lab host="windows-lab-server" event_id=4625
| sort 0 _time
| streamstats time_window=10m count as failed_logins values(username) as usernames_in_window by source_ip
| eval unique_users=mvcount(usernames_in_window)
| where failed_logins>=5 AND unique_users>=5
| dedup source_ip
| table _time source_ip failed_logins unique_users usernames_in_window
